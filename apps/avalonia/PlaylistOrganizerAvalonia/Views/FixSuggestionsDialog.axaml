<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlaylistOrganizerAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PlaylistOrganizerAvalonia.Views.FixSuggestionsDialog"
        x:DataType="vm:FixSuggestionsViewModel"
        Title="Fix Önerileri"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="15">
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Fix Önerileri" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock FontSize="14" Opacity="0.8">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Dosya: {0}">
                            <Binding Path="SelectedTrack.FileName"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
            
            <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}" 
                   Width="30" Height="30" Padding="0" FontSize="16"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Loading -->
                <TextBlock Text="Yükleniyor..." 
                          IsVisible="{Binding IsLoading}"
                          HorizontalAlignment="Center"
                          Margin="0,20"
                          FontSize="16"/>

                <!-- Error -->
                <Border Background="#FF4444"
                       CornerRadius="5"
                       Padding="10"
                       Margin="0,0,0,10"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                              Foreground="White"
                              TextWrapping="Wrap"/>
                </Border>

                <!-- Suggestions List -->
                <ItemsControl x:Name="SuggestionsList" ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2D2D30"
                                   CornerRadius="5"
                                   Padding="15"
                                   Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SuggestedFileName}" 
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding SuggestedPath}" 
                                                  FontSize="12" 
                                                  Opacity="0.7"
                                                  TextWrapping="Wrap"
                                                  Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Confidence, StringFormat='{}{0}%'}" 
                                                      FontSize="14" 
                                                      FontWeight="Bold"
                                                      Foreground="#4CAF50"/>
                                            <TextBlock Text="{Binding Reason}" 
                                                      FontSize="12" 
                                                      Opacity="0.8"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" 
                                           Content="Uygula" 
                                           Command="{Binding $parent[ItemsControl].DataContext.ApplySuggestionCommand}"
                                           CommandParameter="{Binding}"
                                           Margin="10,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- No Suggestions -->
                <TextBlock Text="Öneri bulunamadı" 
                          HorizontalAlignment="Center"
                          Margin="0,20"
                          FontSize="16"
                          Opacity="0.6"
                          IsVisible="{Binding Suggestions.Count, Converter={x:Static ObjectConverters.IsZero}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="1" 
                   Content="Kapat" 
                   Command="{Binding CloseCommand}"
                   Width="100"/>
        </Grid>
    </Grid>
</Window>
