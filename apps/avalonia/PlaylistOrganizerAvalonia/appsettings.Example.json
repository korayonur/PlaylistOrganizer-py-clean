{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=playlistorganizer.db"
  },
  "Database": {
    "Path": "playlistorganizer.db",
    "MaxRetryAttempts": 3,
    "TimeoutSeconds": 30
  },
  "ImportPaths": {
    "Music": "/path/to/your/music",
    "VirtualDJ": "/path/to/VirtualDJ",
    "ExcludePaths": [],
    "PlaylistExtensions": [".m3u", ".m3u8", ".vdjfolder"],
    "MusicExtensions": [
      ".mp3", ".wav", ".cda", ".wma", ".asf", ".ogg", ".m4a", ".aac",
      ".aif", ".aiff", ".flac", ".mpc", ".ape", ".weba", ".opus",
      ".vdj", ".vdjcache", ".vdjedit", ".vdjsample", ".vdjcachev",
      ".mp4", ".ogm", ".ogv", ".avi", ".mpg", ".mpeg", ".wmv",
      ".vob", ".mov", ".divx", ".m4v", ".mkv", ".flv", ".webm",
      ".apng"
    ]
  },
  "ImportSettings": {
    "AutoScan": true,
    "AutoRefresh": true,
    "RefreshIntervalSeconds": 30,
    "MaxConcurrentImports": 5,
    "BatchSize": 100
  },
  "UI": {
    "Theme": "Dark",
    "Language": "tr-TR",
    "AutoRefresh": true,
    "RefreshIntervalSeconds": 30,
    "ShowDebugInfo": false,
    "WindowWidth": 1200,
    "WindowHeight": 800
  },
  "Application": {
    "Name": "Playlist Organizer",
    "Version": "1.0.0",
    "Environment": "Development",
    "DebugMode": false,
    "PerformanceMonitoring": false,
    "LogLevel": "Information",
    "MaxLogFileSize": "10MB",
    "LogRetentionDays": 30
  },
  "Logging": {
    "Enabled": true,
    "Level": "Debug",
    "LogToFile": true,
    "LogFilePath": "logs/playlist-organizer.log",
    "LogToConsole": true,
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "System": "Warning",
      "PlaylistOrganizerAvalonia": "Debug"
    }
  },
  "LemonSqueezy": {
    "ApiKey": "YOUR_API_KEY_HERE_OR_USE_ENV_VAR_LEMONSQUEEZY_API_KEY",
    "ApiUrl": "https://api.lemonsqueezy.com/v1",
    "CheckoutUrl": "YOUR_CHECKOUT_URL_HERE"
  },
  "Security": {
    "UseMockRsaKey": true,
    "RsaPublicKeyPem": null,
    "Comment": "Development: UseMockRsaKey=true (test mode). Production: UseMockRsaKey=false, RsaPublicKeyPem=null (client-only mode) or provide RSA public key (custom backend)"
  }
}

